<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report_work_commencement_notice" model="ir.actions.report">
        <field name="name">Work Commencement Notice / إشعار مباشرة عمل</field>
        <field name="model">hr.employee</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">hr_employee_document_prints.report_work_commencement_notice</field>
        <field name="report_file">hr_employee_document_prints.report_work_commencement_notice</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_type">report</field>
        <field name="print_report_name">'Work Commencement - %s' % (object.name)</field>
    </record>

    <template id="report_work_commencement_notice">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="version" t-value="o.version_id"/>
                <t t-set="nationality_name" t-value="(version.country_id and version.country_id.name) or (o.document_nationality_id and o.document_nationality_id.name) or ''"/>
                <t t-set="id_iqama" t-value="(version.identification_id or '') or (o.document_id_iqama or '')"/>
                <t t-set="email_value" t-value="o.work_email or o.email or o.private_email or ''"/>
                <t t-set="mobile_value" t-value="o.mobile_phone or o.work_phone or o.phone or ''"/>

                <div class="page" dir="rtl" style="font-size: 13px; line-height: 1.8; text-align: right; color: #111;">
                    <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid #d6d6d6; padding-bottom: 10px; margin-bottom: 14px;">
                        <div style="max-width: 72%;">
                            <div style="font-size: 16px; font-weight: 700;" t-esc="o.company_id.name"/>
                            <div style="font-size: 11px; color: #666;" t-esc="o.company_id.partner_id.contact_address or ''"/>
                        </div>
                        <div t-if="o.company_id.logo" style="max-width: 25%; text-align: left;">
                            <img t-att-src="image_data_uri(o.company_id.logo)" alt="Logo" style="max-height: 58px; max-width: 140px;"/>
                        </div>
                    </div>

                    <h2 style="text-align: center; margin: 0 0 16px 0; font-size: 20px;">
                        <span>إشعار مباشرة عمل</span>
                        <br/>
                        <span style="font-size: 13px; color: #555;">Work Commencement Notice</span>
                    </h2>

                    <p style="margin: 0 0 14px 0;">
                        نفيدكم بأن الموظف الموضح بياناته أدناه قد باشر العمل حسب التفاصيل التالية:
                    </p>

                    <table style="width: 100%; border-collapse: collapse; margin-bottom: 18px;">
                        <tbody>
                            <tr>
                                <td style="width: 35%; border: 1px solid #ddd; padding: 6px;"><strong>اسم الموظف / Employee Name</strong></td>
                                <td style="width: 65%; border: 1px solid #ddd; padding: 6px;"><span t-esc="o.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>الجنسية / Nationality</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;"><span t-esc="nationality_name"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>رقم الهوية أو الإقامة / ID or Iqama</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;"><span t-esc="id_iqama"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>البريد الإلكتروني / Email</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;"><span t-esc="email_value"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>الجوال / Mobile</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;"><span t-esc="mobile_value"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>المسمى الوظيفي / Job Title</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;"><span t-esc="(version.job_title or (version.job_id and version.job_id.name) or '')"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>الإدارة أو القسم / Department</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;"><span t-esc="version.department_id and version.department_id.name or ''"/></td>
                            </tr>
                            <tr>
                                <td style="border: 1px solid #ddd; padding: 6px;"><strong>تاريخ المباشرة / Joining Date</strong></td>
                                <td style="border: 1px solid #ddd; padding: 6px;">
                                    <span t-if="o.contract_date_start" t-field="o.contract_date_start"/>
                                    <span t-elif="version.contract_date_start" t-field="version.contract_date_start"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div style="display: flex; justify-content: space-between; margin-top: 26px; text-align: center;">
                        <div style="width: 30%;">
                            <div style="font-weight: 700;">إعداد</div>
                            <div style="margin-top: 24px; border-top: 1px solid #666;">&#160;</div>
                        </div>
                        <div style="width: 30%;">
                            <div style="font-weight: 700;">اعتماد</div>
                            <div style="margin-top: 24px; border-top: 1px solid #666;">&#160;</div>
                        </div>
                        <div style="width: 30%;">
                            <div style="font-weight: 700;">توقيع الموظف</div>
                            <div style="margin-top: 24px; border-top: 1px solid #666;">&#160;</div>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>
</odoo>
