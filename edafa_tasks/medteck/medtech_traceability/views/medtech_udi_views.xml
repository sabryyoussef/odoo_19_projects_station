<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- UDI Tree View -->
    <record id="view_medtech_udi_tree" model="ir.ui.view">
        <field name="name">medtech.udi.tree</field>
        <field name="model">medtech.udi</field>
        <field name="arch" type="xml">
            <list string="UDI Registry" decoration-warning="status == 'quarantined'" decoration-danger="status == 'recalled'">
                <field name="udi_di"/>
                <field name="udi_pi"/>
                <field name="serial_number"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <field name="manufacture_date"/>
                <field name="expiry_date"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- UDI Form View -->
    <record id="view_medtech_udi_form" model="ir.ui.view">
        <field name="name">medtech.udi.form</field>
        <field name="model">medtech.udi</field>
        <field name="arch" type="xml">
            <form string="UDI Record">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="active,quarantined,recalled,expired"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="udi_di" placeholder="UDI-DI (Device Identifier)"/>
                        </h1>
                    </div>
                    <group>
                        <group string="UDI Components">
                            <field name="udi_pi"/>
                            <field name="serial_number"/>
                            <field name="lot_id"/>
                        </group>
                        <group string="Product Info">
                            <field name="product_id"/>
                            <field name="manufacture_date"/>
                            <field name="expiry_date"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- UDI Search View -->
    <record id="view_medtech_udi_search" model="ir.ui.view">
        <field name="name">medtech.udi.search</field>
        <field name="model">medtech.udi</field>
        <field name="arch" type="xml">
            <search string="Search UDI">
                <field name="udi_di"/>
                <field name="udi_pi"/>
                <field name="serial_number"/>
                <field name="lot_id"/>
                <field name="product_id"/>
                <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                <filter string="Quarantined" name="quarantined" domain="[('status', '=', 'quarantined')]"/>
                <filter string="Recalled" name="recalled" domain="[('status', '=', 'recalled')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <group>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Manufacturing Date" name="group_mfg_date" context="{'group_by': 'manufacture_date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- UDI Action -->
    <record id="action_medtech_udi" model="ir.actions.act_window">
        <field name="name">UDI Registry</field>
        <field name="res_model">medtech.udi</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first UDI Record
            </p>
            <p>
                UDI (Unique Device Identification) combines UDI-DI (Device Identifier) 
                with UDI-PI (Production Identifier: serial, lot, expiration date).
            </p>
        </field>
    </record>

</odoo>
