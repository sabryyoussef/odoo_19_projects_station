<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- DHR Tree View -->
    <record id="view_medtech_dhr_tree" model="ir.ui.view">
        <field name="name">medtech.dhr.tree</field>
        <field name="model">medtech.dhr</field>
        <field name="arch" type="xml">
            <list string="Device History Records">
                <field name="display_name"/>
                <field name="serial_lot_id"/>
                <field name="device_master_id"/>
                <field name="manufacture_date"/>
                <field name="customer_id"/>
                <field name="state" decoration-info="state == 'draft'" decoration-success="state == 'approved'"/>
            </list>
        </field>
    </record>

    <!-- DHR Form View -->
    <record id="view_medtech_dhr_form" model="ir.ui.view">
        <field name="name">medtech.dhr.form</field>
        <field name="model">medtech.dhr</field>
        <field name="arch" type="xml">
            <form string="Device History Record">
                <header>
                    <button name="action_compile_dhr" string="Compile DHR" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,compiled,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="display_name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Device Identity">
                            <field name="serial_lot_id"/>
                            <field name="device_master_id"/>
                            <field name="udi_id"/>
                        </group>
                        <group string="Manufacturing">
                            <field name="production_order_id"/>
                            <field name="manufacture_date"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Components &amp; Genealogy">
                            <field name="consumed_component_ids">
                                <list editable="bottom">
                                    <field name="component_product_id"/>
                                    <field name="component_lot_id"/>
                                    <field name="quantity"/>
                                    <field name="consumed_date"/>
                                </list>
                            </field>
                        </page>
                        
                        <page string="Distribution">
                            <group>
                                <field name="customer_id"/>
                                <field name="ship_date"/>
                            </group>
                            <field name="shipment_ids"/>
                        </page>
                        
                        <page string="DHR Compilation" invisible="state == 'draft'">
                            <group>
                                <field name="compiled_date"/>
                                <field name="compiled_by_id"/>
                            </group>
                            <field name="html_snapshot" widget="html" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- DHR Search View -->
    <record id="view_medtech_dhr_search" model="ir.ui.view">
        <field name="name">medtech.dhr.search</field>
        <field name="model">medtech.dhr</field>
        <field name="arch" type="xml">
            <search string="Search DHR">
                <field name="serial_lot_id"/>
                <field name="device_master_id"/>
                <field name="customer_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Compiled" name="compiled" domain="[('state', '=', 'compiled')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <group>
                    <filter string="Device" name="group_device" context="{'group_by': 'device_master_id'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="State" name="group_state" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- DHR Action -->
    <record id="action_medtech_dhr" model="ir.actions.act_window">
        <field name="name">Device History Records</field>
        <field name="res_model">medtech.dhr</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No DHRs yet
            </p>
           <p>
                Device History Records (DHR) compile complete traceability information
                from manufacturing through field service for each serialized device.
            </p>
        </field>
    </record>

</odoo>
