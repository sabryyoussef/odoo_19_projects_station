        <!-- Ian Error #1: Child Loop Missing -->
        <record id="error_ian_01_child_loop" model="error.report">
            <field name="name">Pro-forma Confirmation - Child Loop Error</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-27 14:00:00</field>
            <field name="error_location">Sales → Pro-forma → Confirm</field>
            <field name="module_name">freezoner_custom</field>
            <field name="record_reference">PFI04336</field>
            <field name="impact">critical</field>
            <field name="status">fixed</field>
            <field name="priority">3</field>
            <field name="description"><![CDATA[
                <p>Tried to confirm pro-forma invoice.</p>
                <p>System crashed during task creation.</p>
                <p>Could not complete sale order confirmation.</p>
            ]]></field>
            <field name="error_message">UnboundLocalError: local variable 'child' referenced before assignment</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Create pro-forma invoice</li>
                    <li>Add products with child tasks</li>
                    <li>Click "Confirm"</li>
                    <li>Error at line 385 in sale.py</li>
                </ol>
            ]]></field>
            <field name="fix_commit">38aa51b</field>
            <field name="fix_notes"><![CDATA[
                <p>Added missing loop: for child in task.child_ids:</p>
                <p>File: freezoner_custom/models/sale.py, line 384</p>
                <p>Child tasks now process correctly.</p>
            ]]></field>
            <field name="fixed_date">2025-10-27 16:00:00</field>
        </record>

