<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Khaled Error #1: Sale Order Task Creation -->
        <record id="error_khaled_01_sale_order_planned_hours" model="error.report">
            <field name="name">Sale Order Confirmation - planned_hours Error</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-27 10:00:00</field>
            <field name="error_location">Sales → Orders → Confirm</field>
            <field name="module_name">freezoner_custom</field>
            <field name="impact">critical</field>
            <field name="status">fixed</field>
            <field name="priority">3</field>
            <field name="description"><![CDATA[
                <p>Tried to confirm sale order and system crashed.</p>
                <p>Could not complete sale order confirmation process.</p>
            ]]></field>
            <field name="error_message">AttributeError: 'project.task' object has no attribute 'planned_hours'</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Go to Sales → Orders</li>
                    <li>Create or open a sale order</li>
                    <li>Add products/services that create project tasks</li>
                    <li>Click "Confirm" button</li>
                    <li>Error appears</li>
                </ol>
            ]]></field>
            <field name="fix_commit">e2b9d8c</field>
            <field name="fix_notes"><![CDATA[
                <p>Implemented version-adaptive field mapping for hours field.</p>
                <p>System now automatically detects correct hours field (planned_hours, allocated_hours, etc.)</p>
                <p>File: freezoner_custom/models/sale.py</p>
            ]]></field>
            <field name="fixed_date">2025-10-27 12:00:00</field>
        </record>

        <!-- Khaled Error #2: Documents Inspector -->
        <record id="error_khaled_02_documents_inspector" model="error.report">
            <field name="name">Documents Inspector - Owl Lifecycle Error</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-27 10:30:00</field>
            <field name="error_location">Documents → Click document → Inspector panel</field>
            <field name="module_name">freezoner_custom</field>
            <field name="impact">high</field>
            <field name="status">fixed</field>
            <field name="priority">2</field>
            <field name="description"><![CDATA[
                <p>Clicked on document in Documents app.</p>
                <p>Right panel (Inspector) crashed with Owl error.</p>
                <p>Could not view document details.</p>
            ]]></field>
            <field name="error_message">UncaughtPromiseError > OwlError: Cannot read properties of undefined (reading 'string')</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Go to Documents app</li>
                    <li>Click on any document</li>
                    <li>Inspector panel tries to open</li>
                    <li>Error appears</li>
                </ol>
            ]]></field>
            <field name="fix_commit">173f18d</field>
            <field name="fix_notes"><![CDATA[
                <p>Added field existence guards to OWL template.</p>
                <p>Inspector now checks if fields exist before displaying.</p>
                <p>File: freezoner_custom/static/src/xml/documents.xml</p>
            ]]></field>
            <field name="fixed_date">2025-10-27 13:00:00</field>
        </record>

        <!-- Khaled Error #3: CRM Log Call -->
        <record id="error_khaled_03_crm_log_call" model="error.report">
            <field name="name">CRM Log Call - KeyError 'type'</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-27 11:00:00</field>
            <field name="error_location">CRM → Leads → Log Call button</field>
            <field name="module_name">crm_log</field>
            <field name="impact">critical</field>
            <field name="status">fixed</field>
            <field name="priority">3</field>
            <field name="description"><![CDATA[
                <p>Tried to log a call from CRM lead.</p>
                <p>System crashed and could not log calls.</p>
                <p>Blocked from moving leads through stages.</p>
            ]]></field>
            <field name="error_message">KeyError: 'type' on mail.activity</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Go to CRM → Leads/Pipeline</li>
                    <li>Open any lead</li>
                    <li>Click "Log Call" button</li>
                    <li>Enter call description</li>
                    <li>Click "Submit"</li>
                    <li>Error appears</li>
                </ol>
            ]]></field>
            <field name="fix_commit">eda48ee</field>
            <field name="fix_notes"><![CDATA[
                <p>Removed invalid 'type' field from mail.activity creation.</p>
                <p>Updated to use Odoo 17 API: action_feedback()</p>
                <p>File: crm_log/wizard/call.py</p>
            ]]></field>
            <field name="fixed_date">2025-10-27 14:00:00</field>
        </record>

        <!-- Khaled Error #4: Invoice Owner Change -->
        <record id="error_khaled_04_invoice_owner_change" model="error.report">
            <field name="name">Invoice Owner Change - Notification Error</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-27 11:30:00</field>
            <field name="error_location">Sales → Invoices → Other Info → Salesperson</field>
            <field name="module_name">project_custom</field>
            <field name="impact">medium</field>
            <field name="status">fixed</field>
            <field name="priority">1</field>
            <field name="description"><![CDATA[
                <p>Tried to change "Salesperson" field on pro-forma invoice.</p>
                <p>Could not reassign invoice owner.</p>
            ]]></field>
            <field name="error_message">sale.order object has no attribute '_notify_get_recipients_thread_wim'</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Open pro-forma invoice</li>
                    <li>Go to "Other Info" tab</li>
                    <li>Change "Salesperson" field</li>
