<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Ian Error #4: HR Attendance Check-in -->
        <record id="error_ian_04_attendance_checkin" model="error.report">
            <field name="name">HR Attendance Check-in - Method Signature Error</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-28 10:00:00</field>
            <field name="error_location">Profile Icon → Check In</field>
            <field name="module_name">hr_attendance_ip_mac</field>
            <field name="impact">critical</field>
            <field name="status">fixed</field>
            <field name="priority">3</field>
            <field name="description"><![CDATA[
                <p>Tried to check in using HR attendance.</p>
                <p>System crashed - could not complete check-in or check-out.</p>
                <p>All employees affected.</p>
            ]]></field>
            <field name="error_message">TypeError: HrEmployee._attendance_action_change() takes 1 positional argument but 2 were given</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Click profile icon (top right)</li>
                    <li>Click "Check In" or "Check Out"</li>
                    <li>Error appears</li>
                </ol>
            ]]></field>
            <field name="fix_commit">3377cc9</field>
            <field name="fix_notes"><![CDATA[
                <p>Added geo_ip_response parameter to method signature.</p>
                <p>Method now matches Odoo 17 API.</p>
                <p>File: hr_attendance_ip_mac/models/hr_employee.py, lines 20-21</p>
            ]]></field>
            <field name="fixed_date">2025-10-28 11:00:00</field>
        </record>

        <!-- Ian Clarification: SOV Tab Location -->
        <record id="error_ian_05_sov_location" model="error.report">
            <field name="name">SOV Tab Location - Design Clarification</field>
            <field name="reporter_id" ref="base.user_admin"/>
            <field name="report_date">2025-10-28 10:30:00</field>
            <field name="error_location">Pro-forma Invoice → Tabs</field>
            <field name="module_name">freezoner_custom</field>
            <field name="impact">low</field>
            <field name="status">wont_fix</field>
            <field name="priority">0</field>
            <field name="description"><![CDATA[
                <p>In Odoo 16, SOV tab was on pro-forma invoices.</p>
                <p>In Odoo 17, SOV tab not visible on pro-forma.</p>
                <p>Wondering if this is a bug or missing feature.</p>
            ]]></field>
            <field name="error_message">N/A - Not an error</field>
            <field name="steps_to_reproduce"><![CDATA[
                <ol>
                    <li>Open pro-forma invoice</li>
                    <li>Look for SOV tab</li>
                    <li>Not visible</li>
                </ol>
            ]]></field>
            <field name="fix_notes"><![CDATA[
                <p>Working as designed!</p>
                <p>SOV tab is on Customer Invoices (after confirmation), not on pro-forma.</p>
                <p>Workflow: Confirm pro-forma → Open customer invoice → SOV tab appears.</p>
            ]]></field>
        </record>

    </data>
</odoo>

