<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- Form View -->
    <record id="view_error_report_form" model="ir.ui.view">
        <field name="name">error.report.form</field>
        <field name="model">error.report</field>
        <field name="arch" type="xml">
            <form string="Error Report">
                <header>
                    <button name="action_mark_in_progress" string="Mark In Progress" 
                            type="object" class="btn-primary"
                            invisible="status != 'new'"/>
                    <button name="action_mark_fixed" string="Mark as Fixed" 
                            type="object" class="btn-success"
                            invisible="status == 'fixed'"/>
                    <field name="status" widget="statusbar" 
                           statusbar_visible="new,in_progress,fixed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" type="object" name="action_mark_fixed"
                                icon="fa-check-circle" invisible="status == 'fixed'">
                            <div class="o_field_widget o_stat_info">
                                <span class="o_stat_text">Mark Fixed</span>
                            </div>
                        </button>
                    </div>
                    
                    <widget name="web_ribbon" title="CRITICAL" bg_color="bg-danger" 
                            invisible="impact != 'critical'"/>
                    <widget name="web_ribbon" title="Fixed" bg_color="bg-success" 
                            invisible="status != 'fixed'"/>
                    
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="e.g., Cannot confirm invoice PFI123"/>
                        </h1>
                    </div>
                    
                    <group>
                        <group string="Error Information">
                            <field name="reporter_id" readonly="1"/>
                            <field name="report_date" readonly="1"/>
                            <field name="impact" widget="badge" 
                                   decoration-danger="impact == 'critical'"
                                   decoration-warning="impact == 'high'"
                                   decoration-info="impact == 'medium'"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Location &amp; Context">
                            <field name="error_location" placeholder="e.g., Sales → Invoices → Confirm"/>
                            <field name="module_name" placeholder="e.g., freezoner_custom"/>
                            <field name="record_reference" placeholder="e.g., PFI04336"/>
                            <field name="browser_info" placeholder="e.g., Chrome"/>
                            <field name="current_url" readonly="1" widget="url"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Error Details" name="details">
                            <group>
                                <field name="description" placeholder="Describe what you were trying to do when the error occurred..."/>
                            </group>
                            <separator string="Error Message"/>
                            <field name="error_message" placeholder="Copy and paste the exact error message here (if visible)..."/>
                            <separator string="Steps to Reproduce"/>
                            <field name="steps_to_reproduce" placeholder="1. Go to...&#10;2. Click...&#10;3. Error appears"/>
                        </page>
                        
                        <page string="Screenshots" name="screenshots">
                            <field name="screenshot_ids" widget="many2many_binary" class="o_field_many2many_binary"/>
                        </page>
                        
                        <page string="Fix Details" name="fix" invisible="status == 'new'">
                            <group>
                                <group>
                                    <field name="assigned_to"/>
                                    <field name="fixed_date" readonly="1"/>
                                    <field name="fix_commit"/>
                                </group>
                                <group>
                                    <field name="related_errors"/>
                                </group>
                            </group>
                            <separator string="Fix Notes"/>
                            <field name="fix_notes" placeholder="Describe how this was fixed..."/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- List View (Odoo 19 compatible) -->
    <record id="view_error_report_tree" model="ir.ui.view">
        <field name="name">error.report.list</field>
        <field name="model">error.report</field>
        <field name="arch" type="xml">
            <list string="Error Reports" 
                  decoration-danger="impact == 'critical' and status != 'fixed'"
                  decoration-warning="impact == 'high' and status != 'fixed'"
                  decoration-success="status == 'fixed'"
                  decoration-muted="status == 'wont_fix'">
                <field name="name"/>
                <field name="reporter_id"/>
                <field name="report_date" widget="datetime"/>
                <field name="error_location"/>
                <field name="impact" widget="badge" 
                       decoration-danger="impact == 'critical'"
                       decoration-warning="impact == 'high'"
                       decoration-info="impact == 'medium'"/>
                <field name="status" widget="badge" 
                       decoration-success="status == 'fixed'"
                       decoration-info="status == 'in_progress'"
                       decoration-warning="status == 'new'"/>
                <field name="priority" widget="priority"/>
                <field name="assigned_to"/>
            </list>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="view_error_report_kanban" model="ir.ui.view">
        <field name="name">error.report.kanban</field>
        <field name="model">error.report</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_small_column">
                <field name="color"/>
                <field name="impact"/>
                <field name="status"/>
                <field name="priority"/>
                <field name="reporter_id"/>
                <field name="assigned_to"/>
                <templates>
                    <t t-name="card">
                        <div t-attf-class="oe_kanban_color_#{record.color.raw_value} oe_kanban_card oe_kanban_global_click">
                            <div class="o_dropdown_kanban dropdown">
                                <a class="dropdown-toggle o-no-caret btn" role="button" data-bs-toggle="dropdown" href="#" aria-label="Dropdown menu" title="Dropdown menu">
                                    <span class="fa fa-ellipsis-v"/>
                                </a>
                                <div class="dropdown-menu" role="menu">
                                    <a role="menuitem" type="object" name="action_mark_in_progress" class="dropdown-item">In Progress</a>
                                    <a role="menuitem" type="object" name="action_mark_fixed" class="dropdown-item">Mark Fixed</a>
                                    <a role="menuitem" type="edit" class="dropdown-item">Edit</a>
                                    <a role="menuitem" type="delete" class="dropdown-item">Delete</a>
                                </div>
                            </div>
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_title">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <t t-if="record.impact.raw_value == 'critical'">
                                        <span class="badge badge-danger">🔴 CRITICAL</span>
                                    </t>
                                    <t t-if="record.impact.raw_value == 'high'">
                                        <span class="badge badge-warning">🟡 HIGH</span>
                                    </t>
                                    <div class="text-muted">
                                        <i class="fa fa-map-marker"/> <field name="error_location"/>
                                    </div>
                                    <div class="text-muted">
                                        <i class="fa fa-user"/> <field name="reporter_id"/>
                                    </div>
                                    <div class="text-muted">
                                        <i class="fa fa-clock-o"/> <field name="report_date" widget="datetime"/>
                                    </div>
                                </div>
                                <div class="oe_kanban_footer">
                                    <div class="o_kanban_record_bottom">
                                        <div class="oe_kanban_bottom_left">
                                            <field name="priority" widget="priority"/>
                                        </div>
                                        <div class="oe_kanban_bottom_right">
                                            <field name="assigned_to" widget="many2one_avatar_user"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_error_report_search" model="ir.ui.view">
        <field name="name">error.report.search</field>
        <field name="model">error.report</field>
        <field name="arch" type="xml">
            <search string="Error Reports">
                <field name="name" string="Error" filter_domain="['|', ('name', 'ilike', self), ('error_message', 'ilike', self)]"/>
                <field name="reporter_id"/>
                <field name="error_location"/>
                <field name="module_name"/>
                <separator/>
                <filter string="New" name="filter_new" domain="[('status', '=', 'new')]"/>
                <filter string="In Progress" name="filter_in_progress" domain="[('status', '=', 'in_progress')]"/>
                <filter string="Fixed" name="filter_fixed" domain="[('status', '=', 'fixed')]"/>
                <separator/>
                <filter string="Critical" name="filter_critical" domain="[('impact', '=', 'critical')]"/>
                <filter string="High Priority" name="filter_high" domain="[('impact', '=', 'high')]"/>
                <separator/>
                <filter string="My Reports" name="filter_my_reports" domain="[('reporter_id', '=', uid)]"/>
                <filter string="Assigned to Me" name="filter_assigned_to_me" domain="[('assigned_to', '=', uid)]"/>
                <separator/>
                <filter string="Reporter" name="group_reporter" context="{'group_by': 'reporter_id'}"/>
                <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                <filter string="Impact" name="group_impact" context="{'group_by': 'impact'}"/>
                <filter string="Assigned To" name="group_assigned" context="{'group_by': 'assigned_to'}"/>
                <filter string="Module" name="group_module" context="{'group_by': 'module_name'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_error_report" model="ir.actions.act_window">
        <field name="name">Error Reports</field>
        <field name="res_model">error.report</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No error reports yet!
            </p>
            <p>
                Click the "Report Error" button in the top menu to report an error,<br/>
                or click the + button to create a new error report.
            </p>
        </field>
    </record>

</odoo>

