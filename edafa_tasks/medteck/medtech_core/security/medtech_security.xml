<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        
        <!-- Note: category_id field removed - not supported in Odoo 19 res.groups model -->
        <!-- MedTech Security Categories -->
        <record id="module_category_medtech" model="ir.module.category">
            <field name="name">MedTech Compliance</field>
            <field name="description">Manage MedTech compliance and regulatory features</field>
            <field name="sequence">50</field>
        </record>

        <!-- MedTech Operator -->
        <record id="group_medtech_operator" model="res.groups">
            <field name="name">MedTech Operator</field>
            <field name="comment">Basic operational access - can view records</field>
        </record>

        <!-- Warehouse Supervisor -->
        <record id="group_medtech_warehouse_supervisor" model="res.groups">
            <field name="name">Warehouse Supervisor</field>
            <field name="implied_ids" eval="[Command.link(ref('group_medtech_operator'))]"/>
            <field name="comment">Manage inventory, manage quarantines with approval</field>
        </record>

        <!-- Quality User -->
        <record id="group_medtech_quality_user" model="res.groups">
            <field name="name">Quality User</field>
            <field name="implied_ids" eval="[Command.link(ref('group_medtech_operator'))]"/>
            <field name="comment">Create and manage nonconformances, CAPAs, QC checks</field>
        </record>

        <!-- Quality Manager -->
        <record id="group_medtech_quality_manager" model="res.groups">
            <field name="name">Quality Manager</field>
            <field name="implied_ids" eval="[Command.link(ref('group_medtech_quality_user'))]"/>
            <field name="comment">Approve quality-related actions, close CAPAs</field>
        </record>

        <!-- Regulatory User -->
        <record id="group_medtech_regulatory_user" model="res.groups">
            <field name="name">Regulatory User</field>
            <field name="implied_ids" eval="[Command.link(ref('group_medtech_operator'))]"/>
            <field name="comment">Manage recalls, regulatory reporting</field>
        </record>

        <!-- Regulatory Manager -->
        <record id="group_medtech_regulatory_manager" model="res.groups">
            <field name="name">Regulatory Manager</field>
            <field name="implied_ids" eval="[Command.link(ref('group_medtech_regulatory_user'))]"/>
            <field name="comment">Final approval for regulatory actions, recalls</field>
        </record>

        <!-- Service Technician -->
        <record id="group_medtech_service_technician" model="res.groups">
            <field name="name">Service Technician</field>
            <field name="implied_ids" eval="[Command.link(ref('group_medtech_operator'))]"/>
            <field name="comment">Create service visits, field corrections</field>
        </record>

        <!-- Compliance Auditor (Read-Only + Export) -->
        <record id="group_medtech_compliance_auditor" model="res.groups">
            <field name="name">Compliance Auditor</field>
            <field name="comment">Read-only access to all compliance data + export capability</field>
        </record>

    </data>
</odoo>
