<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_weighing_batch_list" model="ir.ui.view">
        <field name="name">medtech.weighing.batch.list</field>
        <field name="model">medtech.weighing.batch</field>
        <field name="arch" type="xml">
            <list string="Weighing &amp; Dispensing" decoration-success="state == 'moved'" decoration-danger="state == 'qc_failed'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <field name="product_qty"/>
                <field name="operator_id"/>
                <field name="weighed_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_weighing_batch_form" model="ir.ui.view">
        <field name="name">medtech.weighing.batch.form</field>
        <field name="model">medtech.weighing.batch</field>
        <field name="arch" type="xml">
            <form string="Weighing &amp; Dispensing Batch">
                <header>
                    <button name="action_prepare_lines" string="Prepare Lines" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_start_weighing" string="Start Weighing" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_submit_for_qc" string="Submit for QC" type="object" class="oe_highlight" invisible="state != 'in_progress'"/>
                    <button name="action_move_to_compounding" string="Move to Compounding" type="object" class="oe_highlight" invisible="state != 'qc_passed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,qc_pending,qc_passed,qc_failed,moved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Manufacturing Context">
                            <field name="production_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                        </group>
                        <group string="Execution">
                            <field name="operator_id"/>
                            <field name="weighed_at"/>
                            <field name="inprocess_qc_id" readonly="1"/>
                        </group>
                    </group>

                    <group string="Actual Weighed Quantities">
                        <field name="line_ids" nolabel="1">
                            <list editable="bottom">
                                <field name="product_id" readonly="1"/>
                                <field name="lot_id"/>
                                <field name="required_qty" readonly="1"/>
                                <field name="reserved_qty" readonly="1"/>
                                <field name="actual_qty"/>
                                <field name="uom_id" readonly="1"/>
                            </list>
                        </field>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_weighing_batch_search" model="ir.ui.view">
        <field name="name">medtech.weighing.batch.search</field>
        <field name="model">medtech.weighing.batch</field>
        <field name="arch" type="xml">
            <search string="Weighing &amp; Dispensing">
                <field name="name"/>
                <field name="production_id"/>
                <field name="product_id"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="QC Pending" name="qc_pending" domain="[('state', '=', 'qc_pending')]"/>
                <filter string="QC Passed" name="qc_passed" domain="[('state', '=', 'qc_passed')]"/>
                <filter string="Moved" name="moved" domain="[('state', '=', 'moved')]"/>
            </search>
        </field>
    </record>

    <record id="action_medtech_weighing_batch" model="ir.actions.act_window">
        <field name="name">Weighing &amp; Dispensing</field>
        <field name="res_model">medtech.weighing.batch</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create a Weighing &amp; Dispensing record</p>
            <p>Record actual weighed quantities, assign lots, run in-process QC, and move materials to WIP/Compounding.</p>
        </field>
    </record>

</odoo>
