<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_incoming_qc_list" model="ir.ui.view">
        <field name="name">medtech.incoming.qc.list</field>
        <field name="model">medtech.incoming.qc</field>
        <field name="arch" type="xml">
            <list string="Incoming QC" decoration-success="state == 'passed'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="expiration_date"/>
                <field name="quantity_inspected"/>
                <field name="result"/>
                <field name="state"/>
                <field name="checked_by_id"/>
                <field name="checked_at"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_incoming_qc_form" model="ir.ui.view">
        <field name="name">medtech.incoming.qc.form</field>
        <field name="model">medtech.incoming.qc</field>
        <field name="arch" type="xml">
            <form string="Incoming QC Inspection">
                <header>
                    <button name="action_pass" string="Pass" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_fail" string="Fail" type="object" class="btn-danger" invisible="state != 'draft'"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object" invisible="state == 'passed' or state == 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,failed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Material">
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="expiration_date" readonly="1"/>
                            <field name="quantity_inspected"/>
                            <field name="uom_id" readonly="1"/>
                        </group>
                        <group string="Context">
                            <field name="vendor_id"/>
                            <field name="receipt_picking_id"/>
                            <field name="quarantine_location_id"/>
                            <field name="released_location_id"/>
                        </group>
                    </group>
                    <group>
                        <group string="QC Outcome">
                            <field name="result" readonly="1"/>
                            <field name="checked_by_id" readonly="1"/>
                            <field name="checked_at" readonly="1"/>
                            <field name="nonconformance_id" readonly="1"/>
                        </group>
                    </group>
                    <group string="Inspection Notes">
                        <field name="notes" nolabel="1" placeholder="Record inspection observations and acceptance criteria..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_incoming_qc_search" model="ir.ui.view">
        <field name="name">medtech.incoming.qc.search</field>
        <field name="model">medtech.incoming.qc</field>
        <field name="arch" type="xml">
            <search string="Incoming QC">
                <field name="name"/>
                <field name="product_id"/>
                <field name="lot_id"/>
                <field name="vendor_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Passed" name="passed" domain="[('state', '=', 'passed')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <separator/>
                <group>
                    <filter string="By Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="By Result" name="group_result" context="{'group_by': 'result'}"/>
                    <filter string="By Inspector" name="group_checked_by" context="{'group_by': 'checked_by_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medtech_incoming_qc" model="ir.actions.act_window">
        <field name="name">Incoming QC</field>
        <field name="res_model">medtech.incoming.qc</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first Incoming QC inspection</p>
            <p>Incoming QC controls raw material release from quarantine to released stock.</p>
        </field>
    </record>

    <record id="view_production_lot_form_medtech_qc" model="ir.ui.view">
        <field name="name">stock.lot.form.medtech.qc</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet/group" position="inside">
                <group string="MedTech QC">
                    <field name="medtech_qc_status"/>
                    <field name="medtech_qc_released_at" readonly="1"/>
                    <field name="medtech_qc_released_by_id" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_production_lot_tree_medtech_qc" model="ir.ui.view">
        <field name="name">stock.lot.tree.medtech.qc</field>
        <field name="model">stock.lot</field>
        <field name="inherit_id" ref="stock.view_production_lot_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='product_id']" position="after">
                <field name="medtech_qc_status"/>
            </xpath>
        </field>
    </record>

</odoo>
