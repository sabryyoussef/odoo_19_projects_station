<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_final_release_batch_list" model="ir.ui.view">
        <field name="name">medtech.final.release.batch.list</field>
        <field name="model">medtech.final.release.batch</field>
        <field name="arch" type="xml">
            <list string="Final Release" decoration-success="state == 'released'" decoration-warning="state == 'pending_qa'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="finished_lot_id"/>
                <field name="release_qty"/>
                <field name="requested_by_id"/>
                <field name="approved_by_id"/>
                <field name="approved_at"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_final_release_batch_form" model="ir.ui.view">
        <field name="name">medtech.final.release.batch.form</field>
        <field name="model">medtech.final.release.batch</field>
        <field name="arch" type="xml">
            <form string="Final Release Batch">
                <header>
                    <button name="action_request_qa_approval" string="Request QA Approval" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_approve_release" string="Approve Release" type="object" class="oe_highlight" invisible="state != 'pending_qa'"/>
                    <button name="action_release_to_fg" string="Move to FG Released" type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,pending_qa,approved,released"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Context">
                            <field name="production_id"/>
                            <field name="packaging_batch_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="finished_lot_id"/>
                            <field name="release_qty"/>
                        </group>
                        <group string="Approval">
                            <field name="requested_by_id" readonly="1"/>
                            <field name="requested_at" readonly="1"/>
                            <field name="approved_by_id" readonly="1"/>
                            <field name="approved_at" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_final_release_batch_search" model="ir.ui.view">
        <field name="name">medtech.final.release.batch.search</field>
        <field name="model">medtech.final.release.batch</field>
        <field name="arch" type="xml">
            <search string="Final Release">
                <field name="name"/>
                <field name="production_id"/>
                <filter string="Pending QA" name="pending_qa" domain="[('state', '=', 'pending_qa')]"/>
                <filter string="Approved" name="approved" domain="[('state', '=', 'approved')]"/>
                <filter string="Released" name="released" domain="[('state', '=', 'released')]"/>
            </search>
        </field>
    </record>

    <record id="action_medtech_final_release_batch" model="ir.actions.act_window">
        <field name="name">Final Release</field>
        <field name="res_model">medtech.final.release.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
