<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_compounding_batch_list" model="ir.ui.view">
        <field name="name">medtech.compounding.batch.list</field>
        <field name="model">medtech.compounding.batch</field>
        <field name="arch" type="xml">
            <list string="Compounding Batches" decoration-success="state == 'moved'" decoration-danger="state == 'qc_failed'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="operator_id"/>
                <field name="start_at"/>
                <field name="end_at"/>
                <field name="ph_result"/>
                <field name="clarity_result"/>
                <field name="qc_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_compounding_batch_form" model="ir.ui.view">
        <field name="name">medtech.compounding.batch.form</field>
        <field name="model">medtech.compounding.batch</field>
        <field name="arch" type="xml">
            <form string="Compounding Batch">
                <header>
                    <button name="action_start_compounding" string="Start Compounding" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_submit_qc" string="Submit pH/Clarity QC" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress','qc_pending']"/>
                    <button name="action_move_to_sterilization" string="Move to Sterilization" type="object" class="oe_highlight" invisible="state != 'qc_passed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,qc_passed,qc_failed,moved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>

                    <group>
                        <group string="Batch Context">
                            <field name="production_id"/>
                            <field name="weighing_batch_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                        </group>
                        <group string="Execution">
                            <field name="operator_id"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="qc_status" readonly="1"/>
                        </group>
                    </group>

                    <group string="In-Process Tests">
                        <group>
                            <field name="ph_result"/>
                            <field name="ph_min"/>
                            <field name="ph_max"/>
                        </group>
                        <group>
                            <field name="clarity_result"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_compounding_batch_search" model="ir.ui.view">
        <field name="name">medtech.compounding.batch.search</field>
        <field name="model">medtech.compounding.batch</field>
        <field name="arch" type="xml">
            <search string="Compounding Batches">
                <field name="name"/>
                <field name="production_id"/>
                <filter string="In Progress" name="in_progress" domain="[('state', '=', 'in_progress')]"/>
                <filter string="QC Passed" name="qc_passed" domain="[('state', '=', 'qc_passed')]"/>
                <filter string="QC Failed" name="qc_failed" domain="[('state', '=', 'qc_failed')]"/>
                <filter string="Moved" name="moved" domain="[('state', '=', 'moved')]"/>
            </search>
        </field>
    </record>

    <record id="action_medtech_compounding_batch" model="ir.actions.act_window">
        <field name="name">Compounding</field>
        <field name="res_model">medtech.compounding.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
