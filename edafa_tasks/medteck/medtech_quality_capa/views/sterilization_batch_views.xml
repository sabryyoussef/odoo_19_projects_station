<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_sterilization_batch_list" model="ir.ui.view">
        <field name="name">medtech.sterilization.batch.list</field>
        <field name="model">medtech.sterilization.batch</field>
        <field name="arch" type="xml">
            <list string="Sterilization / Filtration" decoration-success="state == 'moved'" decoration-danger="state in ('qc_failed','scrapped')">
                <field name="name"/>
                <field name="production_id"/>
                <field name="operator_id"/>
                <field name="filter_batch"/>
                <field name="sterility_result"/>
                <field name="qc_status"/>
                <field name="decision"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_sterilization_batch_form" model="ir.ui.view">
        <field name="name">medtech.sterilization.batch.form</field>
        <field name="model">medtech.sterilization.batch</field>
        <field name="arch" type="xml">
            <form string="Sterilization / Filtration Batch">
                <header>
                    <button name="action_start_sterilization" string="Start Sterilization" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_mark_passed" string="Mark Sterility Passed" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_mark_failed" string="Mark Sterility Failed" type="object" class="btn-danger" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_move_to_filling" string="Move to Filling" type="object" class="oe_highlight" invisible="state != 'qc_passed'"/>
                    <button name="action_fail_to_scrap" string="Fail to Scrap" type="object" class="btn-danger" invisible="state != 'qc_failed'"/>
                    <button name="action_fail_open_capa" string="Fail and Open CAPA" type="object" class="oe_highlight" invisible="state != 'qc_failed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,qc_passed,qc_failed,moved,scrapped,capa_opened"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Batch Context">
                            <field name="production_id"/>
                            <field name="compounding_batch_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="product_qty" readonly="1"/>
                        </group>
                        <group string="Execution">
                            <field name="operator_id"/>
                            <field name="start_at"/>
                            <field name="end_at"/>
                            <field name="qc_status" readonly="1"/>
                            <field name="decision" readonly="1"/>
                        </group>
                    </group>

                    <group string="Sterile Filtration &amp; QC">
                        <group>
                            <field name="filter_batch"/>
                            <field name="filter_lot_id"/>
                        </group>
                        <group>
                            <field name="sterility_result"/>
                        </group>
                    </group>

                    <group string="Escalation Links">
                        <group>
                            <field name="nonconformance_id" readonly="1"/>
                            <field name="capa_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_sterilization_batch_search" model="ir.ui.view">
        <field name="name">medtech.sterilization.batch.search</field>
        <field name="model">medtech.sterilization.batch</field>
        <field name="arch" type="xml">
            <search string="Sterilization / Filtration">
                <field name="name"/>
                <field name="production_id"/>
                <filter string="QC Passed" name="qc_passed" domain="[('state', '=', 'qc_passed')]"/>
                <filter string="QC Failed" name="qc_failed" domain="[('state', '=', 'qc_failed')]"/>
                <filter string="Moved to Filling" name="moved" domain="[('state', '=', 'moved')]"/>
                <filter string="Scrapped" name="scrapped" domain="[('state', '=', 'scrapped')]"/>
                <filter string="CAPA Opened" name="capa_opened" domain="[('state', '=', 'capa_opened')]"/>
            </search>
        </field>
    </record>

    <record id="action_medtech_sterilization_batch" model="ir.actions.act_window">
        <field name="name">Sterilization / Filtration</field>
        <field name="res_model">medtech.sterilization.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
