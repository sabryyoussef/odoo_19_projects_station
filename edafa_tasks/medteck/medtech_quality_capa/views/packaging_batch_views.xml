<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_packaging_batch_list" model="ir.ui.view">
        <field name="name">medtech.packaging.batch.list</field>
        <field name="model">medtech.packaging.batch</field>
        <field name="arch" type="xml">
            <list string="Packaging" decoration-success="state == 'moved'" decoration-danger="state == 'qc_failed'">
                <field name="name"/>
                <field name="production_id"/>
                <field name="operator_id"/>
                <field name="packaging_at"/>
                <field name="unit_count"/>
                <field name="finished_lot_id"/>
                <field name="final_inspection_result"/>
                <field name="qc_status"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_packaging_batch_form" model="ir.ui.view">
        <field name="name">medtech.packaging.batch.form</field>
        <field name="model">medtech.packaging.batch</field>
        <field name="arch" type="xml">
            <form string="Packaging Batch">
                <header>
                    <button name="action_start_packaging" string="Start Packaging" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_packaging_qc_pass" string="Final Inspection Pass" type="object" class="oe_highlight" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_packaging_qc_fail" string="Final Inspection Fail" type="object" class="btn-danger" invisible="state not in ['draft','in_progress']"/>
                    <button name="action_move_to_fg_quarantine" string="Move to FG Quarantine" type="object" class="oe_highlight" invisible="state != 'qc_passed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,qc_passed,qc_failed,moved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Batch Context">
                            <field name="production_id"/>
                            <field name="filling_batch_id"/>
                            <field name="product_id" readonly="1"/>
                            <field name="unit_count"/>
                            <field name="finished_lot_id" readonly="1"/>
                        </group>
                        <group string="Execution">
                            <field name="operator_id"/>
                            <field name="packaging_at"/>
                            <field name="qc_status" readonly="1"/>
                        </group>
                    </group>

                    <group string="Packaging Checklist">
                        <field name="dropper_cap_inserted"/>
                        <field name="leaflet_inserted"/>
                        <field name="carton_box_applied"/>
                    </group>

                    <group string="Final Packaging Inspection">
                        <field name="final_inspection_result"/>
                    </group>

                    <group string="Escalation">
                        <field name="nonconformance_id" readonly="1"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_packaging_batch_search" model="ir.ui.view">
        <field name="name">medtech.packaging.batch.search</field>
        <field name="model">medtech.packaging.batch</field>
        <field name="arch" type="xml">
            <search string="Packaging">
                <field name="name"/>
                <field name="production_id"/>
                <filter string="QC Passed" name="qc_passed" domain="[('state', '=', 'qc_passed')]"/>
                <filter string="QC Failed" name="qc_failed" domain="[('state', '=', 'qc_failed')]"/>
                <filter string="Moved to FG Quarantine" name="moved" domain="[('state', '=', 'moved')]"/>
            </search>
        </field>
    </record>

    <record id="action_medtech_packaging_batch" model="ir.actions.act_window">
        <field name="name">Packaging</field>
        <field name="res_model">medtech.packaging.batch</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
