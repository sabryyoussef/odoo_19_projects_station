<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_medtech_inprocess_qc_list" model="ir.ui.view">
        <field name="name">medtech.inprocess.qc.list</field>
        <field name="model">medtech.inprocess.qc</field>
        <field name="arch" type="xml">
            <list string="In-Process QC" decoration-success="state == 'passed'" decoration-danger="state == 'failed'">
                <field name="name"/>
                <field name="check_type"/>
                <field name="production_id"/>
                <field name="result"/>
                <field name="state"/>
                <field name="checked_by_id"/>
                <field name="checked_at"/>
            </list>
        </field>
    </record>

    <record id="view_medtech_inprocess_qc_form" model="ir.ui.view">
        <field name="name">medtech.inprocess.qc.form</field>
        <field name="model">medtech.inprocess.qc</field>
        <field name="arch" type="xml">
            <form string="In-Process QC Check">
                <header>
                    <button name="action_pass" string="Pass" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_fail" string="Fail" type="object" class="btn-danger" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,passed,failed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group string="Context">
                            <field name="check_type"/>
                            <field name="production_id"/>
                            <field name="weighing_batch_id"/>
                        </group>
                        <group string="Result">
                            <field name="result" readonly="1"/>
                            <field name="checked_by_id" readonly="1"/>
                            <field name="checked_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1" placeholder="Enter in-process QC findings..."/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_medtech_inprocess_qc_search" model="ir.ui.view">
        <field name="name">medtech.inprocess.qc.search</field>
        <field name="model">medtech.inprocess.qc</field>
        <field name="arch" type="xml">
            <search string="In-Process QC">
                <field name="name"/>
                <field name="production_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Passed" name="passed" domain="[('state', '=', 'passed')]"/>
                <filter string="Failed" name="failed" domain="[('state', '=', 'failed')]"/>
                <group>
                    <filter string="By Check Type" name="group_check_type" context="{'group_by': 'check_type'}"/>
                    <filter string="By Result" name="group_result" context="{'group_by': 'result'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_medtech_inprocess_qc" model="ir.actions.act_window">
        <field name="name">In-Process QC</field>
        <field name="res_model">medtech.inprocess.qc</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
