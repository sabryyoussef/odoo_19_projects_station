        <!-- Nonconformance - open investigation -->
        <record id="nc_00001" model="medtech.nonconformance">
            <field name="name">NC-00001</field>
            <field name="source">manufacturing</field>
            <field name="severity">high</field>
            <field name="description">Battery connection intermittent failure detected during final inspection on CP-2000 batches.</field>
            <field name="detection_date">2026-01-15</field>
            <field name="detected_by_id" ref="base.user_admin"/>
            <field name="containment_action">Quarantined affected in-process units and blocked shipment pending investigation.</field>
            <field name="state">investigation</field>
        </record>

        <!-- Nonconformance - contained supplier issue -->
        <record id="nc_00002" model="medtech.nonconformance">
            <field name="name">NC-00002</field>
            <field name="source">incoming</field>
            <field name="severity">medium</field>
            <field name="description">Incoming silicone tubing from supplier lot showed out-of-spec inner diameter variation.</field>
            <field name="detection_date">2026-01-22</field>
            <field name="detected_by_id" ref="base.user_admin"/>
            <field name="containment_action">Material moved to quarantine and receiving hold released only for conforming lots.</field>
            <field name="root_cause">Supplier process drift due to worn extrusion tooling.</field>
            <field name="state">contained</field>
        </record>

        <!-- Nonconformance - closed complaint -->
        <record id="nc_00003" model="medtech.nonconformance">
            <field name="name">NC-00003</field>
            <field name="source">complaint</field>
            <field name="severity">low</field>
            <field name="description">Customer reported minor label smudging on outer carton after transit.</field>
            <field name="detection_date">2026-02-02</field>
            <field name="detected_by_id" ref="base.user_admin"/>
            <field name="containment_action">Additional overwrap applied for outgoing shipments and stock inspected.</field>
            <field name="root_cause">Ink cure time was below minimum process setting during a short production window.</field>
            <field name="closure_notes">Issue corrected by enforcing minimum cure dwell time and adding line clearance check.</field>
            <field name="state">closed</field>
            <field name="closed_date">2026-02-05</field>
            <field name="closed_by_id" ref="base.user_admin"/>
        </record>

        <!-- CAPA - linked to NC-00001, implementation in progress -->
        <record id="capa_00001" model="medtech.capa">
            <field name="name">CAPA-00001</field>
            <field name="source">nonconformance</field>
            <field name="description">CAPA for battery terminal reliability deviations identified on CP-2000 assembly line.</field>
            <field name="nonconformance_ids" eval="[(4, ref('nc_00001'))]"/>
            <field name="investigation">Failure analysis confirmed inconsistent solder wetting at terminal joint under thermal stress.</field>
            <field name="investigation_date">2026-01-18</field>
            <field name="investigator_id" ref="base.user_admin"/>
            <field name="containment_action">100% inspection introduced for terminal resistance and rework criteria deployed.</field>
            <field name="containment_date">2026-01-19</field>
            <field name="containment_verified">1</field>
            <field name="root_cause_analysis">Root cause traced to nozzle temperature variation and insufficient operator setup checklist.</field>
            <field name="root_cause_method">5_whys</field>
            <field name="root_cause_date">2026-01-21</field>
            <field name="action_plan">Standardize solder station calibration, revise setup checklist, and train all shift operators.</field>
            <field name="action_type">both</field>
            <field name="responsible_id" ref="base.user_admin"/>
            <field name="target_completion_date">2026-03-15</field>
            <field name="implementation_status">in_progress</field>
            <field name="implementation_notes">Calibration SOP approved; operator training 70% complete.</field>
            <field name="qa_approval_required">1</field>
            <field name="stage">implementation</field>
        </record>

        <!-- CAPA - linked to NC-00002, effectiveness check pending -->
        <record id="capa_00002" model="medtech.capa">
            <field name="name">CAPA-00002</field>
            <field name="source">nonconformance</field>
            <field name="description">CAPA for supplier incoming tubing dimension nonconformance and receiving control improvement.</field>
            <field name="nonconformance_ids" eval="[(4, ref('nc_00002'))]"/>
            <field name="investigation">Supplier capability review and incoming trend analysis completed.</field>
            <field name="investigation_date">2026-01-24</field>
            <field name="investigator_id" ref="base.user_admin"/>
            <field name="containment_action">Supplier lots placed on tightened acceptance sampling plan and release by QA only.</field>
            <field name="containment_date">2026-01-25</field>
            <field name="containment_verified">1</field>
            <field name="root_cause_analysis">Extrusion tooling wear exceeded preventive replacement interval.</field>
            <field name="root_cause_method">fishbone</field>
            <field name="root_cause_date">2026-01-27</field>
            <field name="action_plan">Supplier to implement tooling life tracking; internal receiving checklist updated with gauge verification.</field>
            <field name="action_type">corrective</field>
            <field name="responsible_id" ref="base.user_admin"/>
            <field name="target_completion_date">2026-02-20</field>
            <field name="implementation_status">completed</field>
            <field name="implementation_date">2026-02-18</field>
            <field name="implementation_notes">Supplier evidence reviewed; receiving checklist revision released.</field>
            <field name="qa_approval_required">1</field>
            <field name="qa_approved_by_id" ref="base.user_admin"/>
            <field name="qa_approved_date">2026-02-19</field>
            <field name="effectiveness_check_required">1</field>
            <field name="effectiveness_check_date">2026-03-10</field>
            <field name="stage">effectiveness</field>
        </record>

        <!-- CAPA - standalone preventive CAPA closed as effective -->
        <record id="capa_00003" model="medtech.capa">
            <field name="name">CAPA-00003</field>
            <field name="source">risk_assessment</field>
            <field name="description">Preventive CAPA to reduce risk of line mix-up during secondary packaging changeovers.</field>
            <field name="investigation">Risk review identified packaging line clearance as highest residual risk item.</field>
            <field name="investigation_date">2026-01-10</field>
            <field name="investigator_id" ref="base.user_admin"/>
            <field name="containment_action">Introduced independent verification before first-pack release.</field>
            <field name="containment_date">2026-01-11</field>
            <field name="containment_verified">1</field>
            <field name="root_cause_analysis">Visual controls and documented reconciliation points were not standardized across shifts.</field>
            <field name="root_cause_method">fmea</field>
            <field name="root_cause_date">2026-01-13</field>
            <field name="action_plan">Implement barcode-assisted line clearance and mandatory dual sign-off at changeover.</field>
            <field name="action_type">preventive</field>
            <field name="responsible_id" ref="base.user_admin"/>
            <field name="target_completion_date">2026-01-31</field>
            <field name="implementation_status">completed</field>
            <field name="implementation_date">2026-01-29</field>
            <field name="implementation_notes">Procedure released, operators trained, and first two audits showed full compliance.</field>
            <field name="qa_approval_required">1</field>
            <field name="qa_approved_by_id" ref="base.user_admin"/>
            <field name="qa_approved_date">2026-01-30</field>
            <field name="effectiveness_check_required">1</field>
            <field name="effectiveness_check_date">2026-02-20</field>
            <field name="effectiveness_result">effective</field>
            <field name="effectiveness_notes">No packaging mix-up deviations observed in four weeks post implementation.</field>
            <field name="effectiveness_checked_by_id" ref="base.user_admin"/>
            <field name="stage">closed</field>
            <field name="closed_date">2026-02-21</field>
            <field name="closed_by_id" ref="base.user_admin"/>
        </record>
