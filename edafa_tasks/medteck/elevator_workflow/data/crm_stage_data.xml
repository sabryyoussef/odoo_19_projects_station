<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Elevator workflow CRM stages (use in Pipeline or rename default stages manually) -->
    <record id="stage_new_lead" model="crm.stage">
        <field name="name">New Lead</field>
        <field name="sequence">1</field>
        <field name="color">11</field>
    </record>
    <record id="stage_technical_survey" model="crm.stage">
        <field name="name">Technical Survey (Breakdown)</field>
        <field name="sequence">2</field>
        <field name="color">5</field>
    </record>
    <record id="stage_quotation" model="crm.stage">
        <field name="name">Quotation</field>
        <field name="sequence">3</field>
        <field name="color">8</field>
    </record>
    <record id="stage_won" model="crm.stage">
        <field name="name">Won</field>
        <field name="sequence">70</field>
        <field name="is_won" eval="True"/>
        <field name="fold" eval="False"/>
        <field name="color">10</field>
    </record>
</odoo>
