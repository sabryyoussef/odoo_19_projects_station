<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_view_form_elevator_workflow" model="ir.ui.view">
        <field name="name">sale.order.form.elevator.workflow</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_project_tasks" type="object"
                    class="oe_stat_button" icon="fa-tasks">
                    <div class="o_stat_info">
                        <span class="o_stat_value"><field name="x_project_task_count"/></span>
                        <span class="o_stat_text"> Task(s)</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="x_project_task_ids" invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>
