<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Vendor Partner -->
        <record id="partner_batterytech" model="res.partner">
            <field name="name">BatteryTech Solutions Inc.</field>
            <field name="supplier_rank">1</field>
            <field name="company_type">company</field>
            <field name="street">500 Industrial Park Dr</field>
            <field name="city">Boston</field>
            <field name="zip">02101</field>
            <field name="country_id" ref="base.us"/>
            <field name="phone">+1-617-555-0100</field>
            <field name="email">quality@batterytech.example.com</field>
            <field name="group_rfq">default</field>
            <field name="group_on">default</field>
        </record>

        <!-- Vendor Certification -->
        <record id="cert_batterytech_iso13485" model="medtech.vendor.certification">
            <field name="partner_id" ref="partner_batterytech"/>
            <field name="certification_type">iso_13485</field>
            <field name="certificate_number">ISO-13485-2025-BT</field>
            <field name="issue_date">2025-06-01</field>
            <field name="expiry_date">2028-06-01</field>
            <field name="required_for_po" eval="True"/>
        </record>
    </data>
</odoo>
