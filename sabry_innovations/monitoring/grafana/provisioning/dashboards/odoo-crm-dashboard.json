          "rawSql": "-- CRM Lead Audit Status\n-- NOTE: Update datasource to point to your Odoo database\n-- This is a sample query structure\nSELECT \n  'Sample Data' as info,\n  'Configure PostgreSQL datasource to connect to your Odoo database' as instructions\nLIMIT 1;\n\n-- When connected to Odoo database, use this query:\n/*\nSELECT \n  id,\n  name as lead_name,\n  user_id,\n  x_is_audited,\n  x_last_audit_date,\n  create_date,\n  probability,\n  type\nFROM crm_lead\nWHERE type = 'lead'\n  AND probability < 100\nORDER BY create_date DESC\nLIMIT 50;\n*/",
