          "rawSql": "-- Sample data - Replace with Odoo connection\nSELECT \n  NOW() - INTERVAL '6 days' as time, 10 as audited_count\nUNION ALL SELECT NOW() - INTERVAL '5 days', 15\nUNION ALL SELECT NOW() - INTERVAL '4 days', 12\nUNION ALL SELECT NOW() - INTERVAL '3 days', 18\nUNION ALL SELECT NOW() - INTERVAL '2 days', 20\nUNION ALL SELECT NOW() - INTERVAL '1 day', 14\nUNION ALL SELECT NOW(), 22\nORDER BY time;\n\n-- Odoo Query:\n/*\nSELECT \n  DATE(x_last_audit_date) as time,\n  COUNT(*) as audited_count\nFROM crm_lead\nWHERE x_last_audit_date >= NOW() - INTERVAL '7 days'\n  AND x_is_audited = true\nGROUP BY DATE(x_last_audit_date)\nORDER BY time;\n*/",
